let current=0;
const buttons=[...document.querySelectorAll(".room")];
function selectRoom(index){
 current=(index+rooms.length)%rooms.length;const r=rooms[current];
 buttons.forEach((b,i)=>{b.classList.toggle("active",i===current);b.setAttribute("aria-selected",String(i===current));});
 document.getElementById("room-index").textContent=`ROOM ${String(current+1).padStart(2,"0")} / 05`;
 document.getElementById("room-tag").textContent=r.tag;
 document.getElementById("room-title").textContent=r.title;
 document.getElementById("room-description").textContent=r.desc;
 document.getElementById("visual-label").textContent=r.label;
 document.getElementById("visual").dataset.id=r.id;
 document.getElementById("scene-art").innerHTML=scenes[r.id];
 document.getElementById("demo-button").textContent="Watch soundscape ↗";
}
buttons.forEach((b,i)=>b.addEventListener("click",()=>selectRoom(i)));
document.getElementById("next-button").addEventListener("click",()=>selectRoom(current+1));
document.getElementById("demo-button").addEventListener("click",()=>{const r=rooms[current];if(r.demo){window.open(r.demo,"_blank","noopener,noreferrer")}else{alert("The demo video link for this room has not been added yet.")}});
document.addEventListener("keydown",e=>{if(e.key==="ArrowRight")selectRoom(current+1);if(e.key==="ArrowLeft")selectRoom(current-1)});
</script>
